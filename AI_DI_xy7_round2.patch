+    ).fillna(0)
+    work["Jira Status"] = work.get("status", "").fillna("").astype(str).str.strip()
+    work["Jira Status"] = work["Jira Status"].replace(
+        {"": "Unknown", "nan": "Unknown", "None": "Unknown"}
+    )
+
+    status_totals = (
+        work.groupby("Jira Status", as_index=False)["duration_minutes"]
