+    def post_with_retry(sess, url, body, attempts=4):
+        """POST that honours Jira Cloud 429 rate limiting (Retry-After)."""
+        for attempt in range(attempts):
+            response = sess.post(url, json=body, timeout=60)
+            if response.status_code != 429 or attempt == attempts - 1:
+                return response
+            try:
+                wait = float(response.headers.get("Retry-After", 0)) or 2 ** attempt
+            except ValueError:
+                wait = 2 ** attempt
+            time.sleep(min(wait, 10))
+        return response
+
